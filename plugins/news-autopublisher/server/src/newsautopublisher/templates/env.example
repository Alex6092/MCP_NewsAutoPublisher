# Secrets NewsAutoPublisher — ce fichier reste sur ton PC, ne le commite jamais.
# Discord : Paramètres du salon > Intégrations > Webhooks > Nouveau webhook > Copier l'URL
DISCORD_WEBHOOK_EXODE=
DISCORD_WEBHOOK_PLUGINS_EN=
DISCORD_WEBHOOK_PLUGINS_FR=

# OBS : Outils > Paramètres du serveur WebSocket > Afficher les informations de connexion
OBS_WEBSOCKET_PASSWORD=

# Bot Discord (facultatif, seulement pour le crosspost des salons d'annonces)
DISCORD_BOT_TOKEN=

# X en mode API (facultatif, payant) : portail développeur X > ton app > Keys and tokens
# (permissions de l'app : Read and write ; régénère l'Access Token après avoir changé les permissions)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ElevenLabs (facultatif)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
